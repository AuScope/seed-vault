+++ b/seed_vault/qt/resources/map.html
@@ -0,0 +1,178 @@
+<!DOCTYPE html>
+<html>
+<head>
+<meta charset="utf-8">
+<link rel="icon" href="data:,">
+<style>/*LEAFLET_CSS*/</style>
+<style>/*LEAFLET_DRAW_CSS*/</style>
+<style>
+  html, body, #map { height: 100%; margin: 0; padding: 0; }
+  .sv-legend { background: rgba(255,255,255,0.92); padding: 6px 8px; border-radius: 4px;
+               font: 11px/1.3 sans-serif; box-shadow: 0 1px 4px rgba(0,0,0,.3); max-height: 320px; overflow-y: auto; }
+  .sv-legend .sw { display: inline-block; width: 10px; height: 10px; margin-right: 4px; border: 1px solid #333; }
+  .sv-legend .cbar { display: flex; align-items: stretch; padding: 7px 2px 7px 0; }
+  .sv-legend .cbar .title { writing-mode: vertical-rl; transform: rotate(180deg); font-weight: bold;
+                            text-align: center; margin-right: 4px; }
+  .sv-legend .cbar .bar { width: 12px; height: 140px; border: 1px solid #333; box-sizing: border-box; }
+  .sv-legend .cbar .ticks { position: relative; width: 24px; height: 140px; margin-left: 3px; }
+  .sv-legend .cbar .ticks div { position: absolute; left: 0; transform: translateY(-50%); white-space: nowrap; }
+  .sv-popup td { padding: 0 6px 0 0; vertical-align: top; }
+  .sv-popup h4 { margin: 0 0 4px 0; }
+</style>
+<script>/*LEAFLET_JS*/</script>
+<script>/*LEAFLET_DRAW_JS*/</script>
+<script>/*QWEBCHANNEL_JS*/</script>
+</head>
+<body>
+<div id="map"></div>
+<script>
+(function () {
+  "use strict";
+  var LON0 = 0, LON1 = 360;
+  var renderer = L.canvas({ padding: 0.5, tolerance: 4 });
+  var map = L.map('map', { preferCanvas: true, worldCopyJump: false, renderer: renderer,
+                           center: [-20, 180], zoom: 2, minZoom: 1 });
+  L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
+    maxZoom: 18, noWrap: false,
+    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
+  }).addTo(map);
+
+  // Grey out everything outside the active [0, 360) longitude window.
+  L.polygon([[[-90, -10000], [90, -10000], [90, 10000], [-90, 10000]],
+             [[-90, LON0], [-90, LON1], [90, LON1], [90, LON0]]],
+            { stroke: false, fillColor: 'LightSteelBlue', fillOpacity: 0.4, interactive: false }).addTo(map);
+  L.rectangle([[-90, LON0], [90, LON1]], { color: 'dodgerblue', weight: 1, dashArray: '5,5',
+                                           fill: false, interactive: false }).addTo(map);
+
+  // Canvas triangle marker for stations (fast for thousands of points).
+  L.Canvas.include({
+    _updateTriangle: function (layer) {
+      if (!this._drawing || layer._empty()) { return; }
+      var p = layer._point, ctx = this._ctx, r = Math.max(Math.round(layer._radius), 1);
+      ctx.beginPath();
+      ctx.moveTo(p.x, p.y - r);
+      ctx.lineTo(p.x + r, p.y + r * 0.75);
+      ctx.lineTo(p.x - r, p.y + r * 0.75);
+      ctx.closePath();
+      this._fillStroke(ctx, layer);
+    }
+  });
+  var TriangleMarker = L.CircleMarker.extend({
+    _updatePath: function () { this._renderer._updateTriangle(this); }
+  });
+
+  var areaLayer = L.featureGroup().addTo(map);
+  var prevLayer = L.featureGroup().addTo(map);
+  var markerLayer = L.featureGroup().addTo(map);
+  var markersById = {};
+  var bridge = null;
+
+  // Drawing tools: rectangles and circles only; the Python side owns the shapes.
+  var drawn = new L.FeatureGroup().addTo(map);
+  map.addControl(new L.Control.Draw({
+    position: 'topleft',
+    draw: { polyline: false, polygon: false, marker: false, circlemarker: false,
+            rectangle: { shapeOptions: { color: '#5dade2' } },
+            circle: { shapeOptions: { color: '#5dade2' } } },
+    edit: { featureGroup: drawn, edit: false, remove: false }
+  }));
+  map.on(L.Draw.Event.CREATED, function (e) {
+    var g;
+    if (e.layerType === 'rectangle') {
+      var b = e.layer.getBounds();
+      g = { type: 'rectangle', south: b.getSouth(), west: b.getWest(), north: b.getNorth(), east: b.getEast() };
+    } else if (e.layerType === 'circle') {
+      var c = e.layer.getLatLng();
+      g = { type: 'circle', lat: c.lat, lng: c.lng, radius_m: e.layer.getRadius() };
+    }
+    if (g && bridge) { bridge.drawCreated(JSON.stringify(g)); }
+  });
+
+  var legend = L.control({ position: 'bottomright' });
+  legend.onAdd = function () { this._div = L.DomUtil.create('div', 'sv-legend'); this._div.style.display = 'none'; return this._div; };
+  legend.addTo(map);
+
+  map.on('moveend', function () {
+    if (!bridge) { return; }
+    var c = map.getCenter();
+    bridge.viewChanged(c.lat, c.lng, map.getZoom());
+  });
+
+  function styleFor(m) {
+    var sel = !!m.sel;
+    return { radius: m.r * (sel ? 1.2 : 1.0), color: sel ? '#000' : m.color, weight: sel ? 2 : 1,
+             fillColor: m.color, fillOpacity: sel ? 1.0 : (m.fo === undefined ? 0.35 : m.fo) };
+  }
+
+  function buildLayer(group, list, layerName) {
+    group.clearLayers();
+    var index = {};
+    for (var i = 0; i < list.length; i++) {
+      var m = list[i];
+      var mk = (m.shape === 'tri') ? new TriangleMarker([m.lat, m.lon], styleFor(m)) : L.circleMarker([m.lat, m.lon], styleFor(m));
+      mk._sv = m;
+      if (m.tip) { mk.bindTooltip(m.tip, { sticky: true }); }
+      if (m.popup) { mk.bindPopup(m.popup, { maxWidth: 420 }); }
+      (function (id) {
+        mk.on('click', function () { if (bridge) { bridge.markerClicked(layerName, id); } });
+      })(m.id);
+      group.addLayer(mk);
+      index[m.id] = mk;
+    }
+    return index;
+  }
+
+  window.SV = {
+    setMarkers: function (list) { markersById = buildLayer(markerLayer, list, 'main'); },
+    setPrevMarkers: function (list) { buildLayer(prevLayer, list, 'prev'); },
+    setSelected: function (ids) {
+      var want = {};
+      for (var i = 0; i < ids.length; i++) { want[ids[i]] = true; }
+      for (var k in markersById) {
+        var mk = markersById[k], m = mk._sv, s = !!want[k];
+        if (m.sel !== s) { m.sel = s; mk.setStyle(styleFor(m)); mk.setRadius(styleFor(m).radius); if (s) { mk.bringToFront(); } }
+      }
+    },
+    setAreas: function (areas) {
+      areaLayer.clearLayers();
+      drawn.clearLayers();
+      for (var i = 0; i < areas.length; i++) {
+        var a = areas[i], col = a.color || '#5dade2';
+        if (a.type === 'rect') {
+          areaLayer.addLayer(L.rectangle([[a.min_lat, a.min_lon], [a.max_lat, a.max_lon]],
+                                         { color: col, weight: 2, fillOpacity: 0.15, interactive: false }));
+        } else if (a.type === 'circle') {
+          if (a.min_r_m > 0) {
+            areaLayer.addLayer(L.circle([a.lat, a.lon], { radius: a.max_r_m, stroke: false, fillColor: col, fillOpacity: 0.15, interactive: false }));
+            areaLayer.addLayer(L.circle([a.lat, a.lon], { radius: a.max_r_m, color: col, weight: 2, fill: false, interactive: false }));
+            areaLayer.addLayer(L.circle([a.lat, a.lon], { radius: a.min_r_m, color: col, weight: 2, dashArray: '2,4', fill: false, interactive: false }));
+          } else {
+            areaLayer.addLayer(L.circle([a.lat, a.lon], { radius: a.max_r_m, color: col, weight: 2, fillOpacity: 0.15, interactive: false }));
+          }
+        }
+      }
+    },
+    setLegend: function (html) {
+      legend._div.innerHTML = html || '';
+      legend._div.style.display = html ? 'block' : 'none';
+    },
+    setView: function (lat, lng, zoom) { map.setView([lat, lng], zoom, { animate: false }); },
+    fitMarkers: function () {
+      var b = markerLayer.getBounds();
+      if (b.isValid()) { map.fitBounds(b.pad(0.15), { maxZoom: 7 }); }
+    },
+    openPopup: function (id) {
+      var mk = markersById[id];
+      if (mk) { map.panTo(mk.getLatLng()); mk.openPopup(); }
+    },
+    invalidate: function () { map.invalidateSize(); }
+  };
+
+  new QWebChannel(qt.webChannelTransport, function (channel) {
+    bridge = channel.objects.bridge;
+    bridge.ready();
+  });
+})();
+</script>
+</body>
+</html>
diff --git a/seed_vault/qt/run_config_page.py b/seed_vault/qt/run_config_page.py
new file mode 100644
index 0000000..d293dc6
--- /dev/null
+++ b/seed_vault/qt/run_config_page.py
@@ -0,0 +1,178 @@
+"""Run a workflow directly from a text config (``config_direct.cfg``).
+
+Qt port of ``seed_vault.ui.components.run_from_config.RunFromConfigComponent``.
+"""
+import html
+import os
+import tempfile
+
+from PySide6.QtCore import Qt, QUrl
+from PySide6.QtGui import QDesktopServices
+from PySide6.QtWidgets import QFileDialog, QLabel, QPlainTextEdit, QSplitter, QVBoxLayout, QWidget
+
+from seed_vault.qt.widgets import Banner, LogView, button, hbox, mono_font
+from seed_vault.qt.workers import run_task_with_stop
+from seed_vault.service.seismoloader import run_main
+from seed_vault.service.settings_store import (DIRECT_CONFIG_PATH, default_settings, render_config,
+                                               validate_config_file)
+from seed_vault.utils.constants import DOC_BASE_URL
+
+
+class RunConfigPage(QWidget):
+    def __init__(self, parent=None, config_path: str = DIRECT_CONFIG_PATH):
+        super().__init__(parent)
+        self.path = config_path
+        self._task = None
+        self._saved_text = ""
+
+        lay = QVBoxLayout(self)
+        lay.setContentsMargins(8, 8, 8, 8)
+        lay.addWidget(QLabel("Set the search parameters directly and run your workflow in one go. "
+                             "Edits are validated when saved."))
+        self.banner = Banner()
+        lay.addWidget(self.banner)
+
+        split = QSplitter(Qt.Horizontal)
+        left = QWidget()
+        ll = QVBoxLayout(left)
+        ll.setContentsMargins(0, 0, 0, 0)
+        self.save_btn = button("Save", self.save, "Save and validate (Ctrl+S)")
+        self.save_btn.setShortcut("Ctrl+S")
+        self.revert_btn = button("Revert", self.load, "Discard unsaved edits")
+        self.reset_btn = button("Reset to defaults", self.reset_defaults)
+        self.import_btn = button("Open…", self.open_file, "Load parameters from another .cfg file")
+        self.export_btn = button("Save as…", self.save_as)
+        help_btn = button("Help", lambda: QDesktopServices.openUrl(
+            QUrl(f"{DOC_BASE_URL}/flows/run_from_parameters.html#parameter-reference")))
+        ll.addLayout(hbox(self.save_btn, self.revert_btn, self.reset_btn, self.import_btn, self.export_btn,
+                          None, help_btn))
+        self.editor = QPlainTextEdit()
+        self.editor.setFont(mono_font())
+        self.editor.setLineWrapMode(QPlainTextEdit.NoWrap)
+        self.editor.textChanged.connect(self._on_text_changed)
+        ll.addWidget(self.editor, 1)
+        split.addWidget(left)
+
+        right = QWidget()
+        rl = QVBoxLayout(right)
+        rl.setContentsMargins(0, 0, 0, 0)
+        self.run_btn = button("▶  Run", self.run, primary=True)
+        self.cancel_btn = button("Cancel", self.cancel)
+        self.cancel_btn.setEnabled(False)
+        self.dirty_label = QLabel()
+        self.dirty_label.setStyleSheet("color: #a15c00;")
+        rl.addLayout(hbox(self.run_btn, self.cancel_btn, self.dirty_label, None,
+                          button("Clear log", lambda: self.log.clear_log())))
+        self.log = LogView()
+        rl.addWidget(self.log, 1)
+        split.addWidget(right)
+        split.setSizes([600, 600])
+        lay.addWidget(split, 1)
+        self.load()
+
+    # ------------------------------------------------------------------
+    def load(self):
+        try:
+            with open(self.path, encoding="utf-8") as f:
+                self._saved_text = f.read()
+        except FileNotFoundError:
+            self._saved_text = render_config(default_settings())
+        self.editor.setPlainText(self._saved_text)
+        self._validate()
+
+    def _on_text_changed(self):
+        dirty = self.editor.toPlainText() != self._saved_text
+        self.dirty_label.setText("Unsaved changes – Run uses the saved file" if dirty else "")
+
+    def _validate(self) -> bool:
+        try:
+            errors, warnings = validate_config_file(self.path)
+        except Exception as e:  # noqa: BLE001
+            self.banner.error(f"Could not parse configuration: {html.escape(str(e))}")
+            return False
+        if errors:
+            self.banner.error(f"<pre>{html.escape(errors)}</pre><b>Please resolve the errors before running.</b>")
+        elif warnings:
+            self.banner.warning(f"<pre>{html.escape(warnings)}</pre>")
+        else:
+            self.banner.hide()
+        return not errors
+
+    def _write(self, text: str, path: str):
+        with open(path, "w", encoding="utf-8") as f:
+            f.write(text)
+
+    def save(self):
+        text = self.editor.toPlainText()
+        # validate a temp copy first so a broken edit never replaces a working file silently
+        with tempfile.NamedTemporaryFile("w", suffix=".cfg", delete=False, encoding="utf-8") as tmp:
+            tmp.write(text)
+        try:
+            errors, _ = validate_config_file(tmp.name)
+        except Exception as e:  # noqa: BLE001
+            errors = str(e)
+        finally:
+            os.unlink(tmp.name)
+        self._write(text, self.path)
+        self._saved_text = text
+        self._on_text_changed()
+        if self._validate():
+            self.banner.success("Configuration saved." if not errors else "Configuration saved with errors.")
+
+    def reset_defaults(self):
+        self.editor.setPlainText(render_config(default_settings()))
+        self.save()
+
+    def open_file(self):
+        path, _ = QFileDialog.getOpenFileName(self, "Open config", "", "Config (*.cfg);;All files (*)")
+        if path:
+            with open(path, encoding="utf-8") as f:
+                self.editor.setPlainText(f.read())
+            self.banner.info(f"Loaded {os.path.basename(path)} – click Save to use it.")
+
+    def save_as(self):
+        path, _ = QFileDialog.getSaveFileName(self, "Save config as", "config.cfg", "Config (*.cfg)")
+        if path:
+            self._write(self.editor.toPlainText(), path)
+            self.banner.success(f"Saved a copy to {path}")
+
+    # ------------------------------------------------------------------
+    def _set_running(self, running: bool):
+        self.run_btn.setEnabled(not running)
+        self.cancel_btn.setEnabled(running)
+        for w in (self.editor, self.save_btn, self.revert_btn, self.reset_btn, self.import_btn):
+            w.setEnabled(not running)
+
+    def run(self):
+        if self._task is not None:
+            return
+        if self.editor.toPlainText() != self._saved_text:
+            self.save()
+        if not self._validate():
+            return
+        self.log.append_text("Starting config processing…\n")
+        self._set_running(True)
+        self.banner.info("Running… progress appears in the log.")
+        self._task = run_task_with_stop(
+            lambda stop: run_main(settings=None, from_file=self.path, stop_event=stop),
+            on_log=self.log.append_text, on_success=self._on_result,
+            on_error=lambda m: self.banner.error(f"Processing encountered errors: {html.escape(m)}"),
+            on_done=self._on_done)
+
+    def cancel(self):
+        if self._task is not None:
+            self._task.cancel()
+            self.cancel_btn.setEnabled(False)
+            self.banner.warning("Cancelling… (finishing the current request)")
+
+    def _on_result(self, result):
+        if self._task is not None and self._task.stop_event.is_set():
+            self.banner.warning("Processing was cancelled by user.")
+        elif result:
+            self.banner.success("Processing completed successfully!")
+        else:
+            self.banner.warning("Processing finished without results. Check the log for details.")
+
+    def _on_done(self):
+        self._task = None
+        self._set_running(False)
