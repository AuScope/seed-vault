+        if visible_only:
+            labels = [self.model.label_for_row(self.proxy.mapToSource(self.proxy.index(r, 0)).row())
+                      for r in range(self.proxy.rowCount())]
+        else:
+            labels = list(self.df.index)
+        self.model.set_checked(labels, value)
