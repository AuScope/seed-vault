+"""SQLite explorer for the local archive database.
+
+Qt port of ``seed_vault.ui.components.data_explorer.DataExplorerComponent``.
+"""
+import html
+import time
+
+from PySide6.QtCore import QRegularExpression, Qt, QUrl
+from PySide6.QtGui import QDesktopServices, QFont, QSyntaxHighlighter, QTextCharFormat, QColor
+from PySide6.QtWidgets import (QCheckBox, QLabel, QListWidget, QListWidgetItem, QPlainTextEdit, QSplitter,
+                               QTableView, QTabWidget, QTreeWidget, QTreeWidgetItem, QVBoxLayout, QWidget)
+
+from seed_vault.qt.widgets import Banner, DataFrameModel, FilterProxy, button, hbox, mono_font
+from seed_vault.qt.workers import run_task
+from seed_vault.service.db import DatabaseManager
+from seed_vault.service.settings_store import load_settings
+
+EXAMPLES = [
+    "SELECT * FROM archive_data LIMIT 100",
+    "SELECT * FROM arrival_data LIMIT 100",
+    "SELECT DISTINCT network, station FROM archive_data",
+    "SELECT network, station, COUNT(*) AS n FROM archive_data GROUP BY network, station ORDER BY n DESC",
+    'DELETE FROM archive_data WHERE network="IU" AND station="DAV"',
+]
+MAX_ROWS_SHOWN = 200_000
+KEYWORDS = ("select from where and or not insert into values update set delete create drop alter table "
+            "index view join left right inner outer on group by order having limit offset distinct as "
+            "count sum avg min max like in is null between case when then else end union all pragma").split()
+
+
+class SqlHighlighter(QSyntaxHighlighter):
+    def __init__(self, doc):
+        super().__init__(doc)
+        kw = QTextCharFormat()
+        kw.setForeground(QColor("#0b57d0"))
+        kw.setFontWeight(QFont.Bold)
+        st = QTextCharFormat()
+        st.setForeground(QColor("#b3261e"))
+        cm = QTextCharFormat()
+        cm.setForeground(QColor("#777"))
+        num = QTextCharFormat()
+        num.setForeground(QColor("#006c4c"))
+        self.rules = [(QRegularExpression(r"\b(" + "|".join(KEYWORDS) + r")\b",
+                                          QRegularExpression.CaseInsensitiveOption), kw),
+                      (QRegularExpression(r"\b\d+(\.\d+)?\b"), num),
+                      (QRegularExpression(r"'[^']*'|\"[^\"]*\""), st),
+                      (QRegularExpression(r"--[^\n]*"), cm)]
+
+    def highlightBlock(self, text):
+        for rx, fmt in self.rules:
+            it = rx.globalMatch(text)
+            while it.hasNext():
+                m = it.next()
+                self.setFormat(m.capturedStart(), m.capturedLength(), fmt)
+
+
+def _match_pk(v):
+    return {None: "", 0: "", 1: "Primary key", 2: "Foreign key"}.get(v, "Other")
+
+
+class DbExplorerPage(QWidget):
+    def __init__(self, parent=None):
+        super().__init__(parent)
+        self.db: DatabaseManager = None
+        self.db_path = None
+        self._task = None
+
+        lay = QVBoxLayout(self)
+        lay.setContentsMargins(8, 8, 8, 8)
+        self.path_label = QLabel()
+        self.path_label.setTextInteractionFlags(Qt.TextSelectableByMouse)
+        docs = button("Documentation", lambda: QDesktopServices.openUrl(
+            QUrl("https://auscope.github.io/seed-vault/app_db_explorer.html")))
+        lay.addLayout(hbox(self.path_label, None, button("Reload database", self.reload), docs))
+
+        self.tabs = QTabWidget()
+        lay.addWidget(self.tabs, 1)
+
+        # -- query tab
+        q = QWidget()
+        ql = QVBoxLayout(q)
+        ql.setContentsMargins(0, 4, 0, 0)
+        split = QSplitter(Qt.Vertical)
+        self.editor = QPlainTextEdit("SELECT * FROM archive_data LIMIT 10")
+        self.editor.setFont(mono_font(11))
+        SqlHighlighter(self.editor.document())
+        split.addWidget(self.editor)
+        res = QWidget()
+        rl = QVBoxLayout(res)
+        rl.setContentsMargins(0, 0, 0, 0)
+        self.exec_btn = button("▶  Execute (Ctrl+Enter)", self.execute, primary=True)
+        self.exec_btn.setShortcut("Ctrl+Return")
+        self.status = QLabel()
+        self.export_btn = button("Export CSV…", self.export_csv)
+        rl.addLayout(hbox(self.exec_btn, self.status, None, self.export_btn))
+        self.banner = Banner()
+        rl.addWidget(self.banner)
+        self.model = DataFrameModel()
+        self.proxy = FilterProxy()
+        self.proxy.setSourceModel(self.model)
+        self.result_view = QTableView()
+        self.result_view.setModel(self.proxy)
+        self.result_view.setSortingEnabled(True)
+        self.result_view.setAlternatingRowColors(True)
+        self.result_view.verticalHeader().setDefaultSectionSize(20)
+        rl.addWidget(self.result_view, 1)
+        split.addWidget(res)
+        split.setSizes([150, 500])
+        ql.addWidget(split)
+        self.tabs.addTab(q, "Execute SQL")
+
+        # -- history
+        self.history = QListWidget()
+        self.history.setFont(mono_font())
+        self.history.itemDoubleClicked.connect(lambda it: self._load_query(it.data(Qt.UserRole)))
+        h = QWidget()
+        hl = QVBoxLayout(h)
+        hl.addWidget(QLabel("Double-click a query to load it into the editor."))
+        hl.addWidget(self.history)
+        self.tabs.addTab(h, "Query history")
+
+        # -- schema
+        s = QWidget()
+        sl = QVBoxLayout(s)
+        self.show_types = QCheckBox("Show types")
+        self.show_types.setChecked(True)
+        self.show_types.toggled.connect(self.refresh_schema)
+        self.schema = QTreeWidget()
+        self.schema.setHeaderLabels(["Table / column", "Type", "Key"])
+        sl.addWidget(self.show_types)
+        sl.addWidget(self.schema)
+        self.tabs.addTab(s, "DB schema")
+
+        # -- examples
+        ex = QListWidget()
+        ex.setFont(mono_font())
+        for e in EXAMPLES:
+            it = QListWidgetItem(e)
+            it.setData(Qt.UserRole, e)
+            ex.addItem(it)
+        ex.itemDoubleClicked.connect(lambda it: self._load_query(it.data(Qt.UserRole)))
+        e = QWidget()
+        el = QVBoxLayout(e)
+        el.addWidget(QLabel("Double-click an example to load it into the editor. "
+                            "<b>DELETE / UPDATE statements modify your database.</b>"))
+        el.addWidget(ex)
+        self.tabs.addTab(e, "Example queries")
+
+    # ------------------------------------------------------------------
+    def reload(self):
+        try:
+            path = load_settings().db_path
+        except Exception as e:  # noqa: BLE001
+            self.banner.error(f"Could not read settings: {e}")
+            return
+        self.db_path = path
+        self.db = DatabaseManager(path)
+        self.path_label.setText(f"Database: <code>{html.escape(path)}</code>")
+        self.refresh_schema()
+
+    def showEvent(self, e):
+        super().showEvent(e)
+        if self.db is None:
+            self.reload()
+
+    def refresh_schema(self, *_):
+        self.schema.clear()
+        if self.db is None:
+            return
+        show_types = self.show_types.isChecked()
+        try:
+            with self.db.connection() as conn:
+                cur = conn.cursor()
+                for (table,) in cur.execute("SELECT name FROM sqlite_master WHERE type='table'").fetchall():
+                    t = QTreeWidgetItem([table])
+                    for row in conn.cursor().execute(f"PRAGMA table_info('{table}')"):
+                        t.addChild(QTreeWidgetItem([row[1], row[2].upper() if show_types else "",
+                                                    _match_pk(row[5])]))
+                    self.schema.addTopLevelItem(t)
+                    t.setExpanded(True)
+            self.schema.resizeColumnToContents(0)
+        except Exception as e:  # noqa: BLE001
+            self.banner.error(f"Could not read schema: {e}")
+
+    def _load_query(self, q):
+        self.editor.setPlainText(q)
+        self.tabs.setCurrentIndex(0)
+
+    def execute(self):
+        if self._task is not None or self.db is None:
+            return
+        query = self.editor.textCursor().selectedText().replace(" ", "\n").strip() or \
+            self.editor.toPlainText().strip()
+        if not query:
+            return
+        first = query.split()[0].upper()
+        if first in ("DELETE", "DROP", "UPDATE", "ALTER", "TRUNCATE"):
+            from PySide6.QtWidgets import QMessageBox
+            if QMessageBox.question(self, "Modify database?",
+                                    f"This {first} statement will modify your database. Continue?") \
+                    != QMessageBox.Yes:
+                return
+        self.banner.hide()
+        self.status.setText("Running…")
+        self.exec_btn.setEnabled(False)
+        t0 = time.perf_counter()
+
+        def ok(result):
+            has_error, message, df = result
+            ms = int((time.perf_counter() - t0) * 1000)
+            self.status.setText(f"{ms} ms · {time.strftime('%X')}")
+            (self.banner.error if has_error else self.banner.success)(html.escape(message))
+            if df is not None:
+                if df.columns.has_duplicates:
+                    df.columns = _dedupe(df.columns)
+                if len(df) > MAX_ROWS_SHOWN:
+                    self.banner.warning(f"{html.escape(message)} Showing the first {MAX_ROWS_SHOWN:,} rows.")
+                    df = df.head(MAX_ROWS_SHOWN)
+                self.model.set_dataframe(df)
+                self.result_view.resizeColumnsToContents()
+            self._add_history(query, ms, message)
+            if not has_error and query.split()[0].upper() in ("CREATE", "DROP", "ALTER"):
+                self.refresh_schema()
+
+        self._task = run_task(self.db.execute_query, query, on_success=ok,
+                              on_error=lambda m: self.banner.error(html.escape(m)),
+                              on_done=self._done, capture_output=False)
+
+    def _done(self):
+        self._task = None
+        self.exec_btn.setEnabled(True)
+
+    def _add_history(self, query, ms, message):
+        if self.history.count() and self.history.item(0).data(Qt.UserRole) == query:
+            return
+        it = QListWidgetItem(f"[{time.strftime('%X')}] {ms} ms – {message}\n{query}")
+        it.setData(Qt.UserRole, query)
+        self.history.insertItem(0, it)
+        while self.history.count() > 50:
+            self.history.takeItem(self.history.count() - 1)
+
+    def export_csv(self):
+        df = self.model.dataframe()
+        if df is None or df.empty:
+            return self.banner.warning("Run a SELECT query first.")
+        from PySide6.QtWidgets import QFileDialog
+        path, _ = QFileDialog.getSaveFileName(self, "Export results", "query.csv", "CSV (*.csv)")
+        if path:
+            df.to_csv(path, index=False)
+            self.banner.success(f"Exported {len(df)} rows to {html.escape(path)}")
+
+
+def _dedupe(cols):
+    seen, out = {}, []
+    for c in cols:
+        seen[c] = seen.get(c, 0) + 1
+        out.append(c if seen[c] == 1 else f"{c}_{seen[c]}")
+    return out
diff --git a/seed_vault/qt/map_widget.py b/seed_vault/qt/map_widget.py
new file mode 100644
index 0000000..1842ead
--- /dev/null
+++ b/seed_vault/qt/map_widget.py
@@ -0,0 +1,342 @@
+"""Leaflet map embedded in Qt (QWebEngineView + QWebChannel).
+
+Python pushes markers/areas into the page with small JSON calls; the page
+reports drawn shapes, marker clicks and view changes back through ``_Bridge``.
+"""
+import base64
+import html
+import json
+import os
+import re
+from typing import Dict, List, Optional
+
+import numpy as np
+import pandas as pd
+import matplotlib as mpl
+import matplotlib.colors as mcolors
+from obspy.geodetics import degrees2kilometers, kilometer2degrees
+from PySide6.QtCore import QCoreApplication, QFile, QIODevice, QObject, QUrl, Signal, Slot
+from PySide6.QtWebChannel import QWebChannel
+from PySide6.QtWebEngineCore import QWebEnginePage, QWebEngineProfile
+from PySide6.QtWebEngineWidgets import QWebEngineView
+from PySide6.QtWidgets import QVBoxLayout, QWidget
+
+from seed_vault.enums.ui import Steps
+from seed_vault.models.common import CircleArea, RectangleArea
+from seed_vault.models.config import GeometryConstraint
+from seed_vault.utils.constants import AREA_COLOR
+from seed_vault.utils.geo import lon_to_360, normalize_bounds, normalize_circle
+
+RESOURCE_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), "resources")
+# The page is given this origin so tile servers receive a meaningful Referer
+# (OSM's tile policy requires one). Every asset is inlined, so nothing is
+# actually fetched from it.
+PAGE_ORIGIN = "https://auscope.github.io/seed-vault/"
+
+DEPTH_VMIN, DEPTH_VMAX = -5.0, 500.0
+MAX_LEGEND_CATEGORIES = 15
+
+
+# ----------------------------------------------------------------------------
+# Network plumbing
+# ----------------------------------------------------------------------------
+_profile: Optional[QWebEngineProfile] = None
+
+
+def _shared_profile() -> QWebEngineProfile:
+    global _profile
+    if _profile is None:
+        # Parented to the application so it outlives every page using it.
+        _profile = QWebEngineProfile("seed-vault-map", QCoreApplication.instance())  # persistent tile cache
+        _profile.setHttpUserAgent(_profile.httpUserAgent() + " SEED-Vault")
+    return _profile
+
+
+_page_html: Optional[str] = None
+
+
+def _data_uri(path: str) -> str:
+    ext = os.path.splitext(path)[1].lstrip(".")
+    mime = {"png": "image/png", "svg": "image/svg+xml"}.get(ext, "application/octet-stream")
+    with open(path, "rb") as f:
+        return f"data:{mime};base64,{base64.b64encode(f.read()).decode()}"
+
+
+def _inline_css(path: str) -> str:
+    css = open(path, encoding="utf-8").read()
+    img_dir = os.path.join(os.path.dirname(path), "images")
+
+    def repl(m):
+        name = m.group(1).strip("'\"")
+        if name.startswith("images/"):
+            return f"url('{_data_uri(os.path.join(img_dir, name[len('images/'):]))}')"
+        return m.group(0)
+    return re.sub(r"url\(([^)]*)\)", repl, css)
+
+
+def page_html() -> str:
+    """map.html with Leaflet, Leaflet.draw and qwebchannel.js inlined."""
+    global _page_html
+    if _page_html is None:
+        lf = os.path.join(RESOURCE_DIR, "leaflet")
+        qf = QFile(":/qtwebchannel/qwebchannel.js")
+        qf.open(QIODevice.ReadOnly)
+        qwc = bytes(qf.readAll()).decode("utf-8")
+        qf.close()
+        html_src = open(os.path.join(RESOURCE_DIR, "map.html"), encoding="utf-8").read()
+        for key, val in {
+            "/*LEAFLET_CSS*/": _inline_css(os.path.join(lf, "leaflet.css")),
+            "/*LEAFLET_DRAW_CSS*/": _inline_css(os.path.join(lf, "leaflet.draw.css")),
+            "/*LEAFLET_JS*/": open(os.path.join(lf, "leaflet.js"), encoding="utf-8").read(),
+            "/*LEAFLET_DRAW_JS*/": open(os.path.join(lf, "leaflet.draw.js"), encoding="utf-8").read(),
+            "/*QWEBCHANNEL_JS*/": qwc,
+        }.items():
+            html_src = html_src.replace(key, val.replace("</script", "<\\/script"))
+        _page_html = html_src
+    return _page_html
+
+
+class _Bridge(QObject):
+    readySig = Signal()
+    drawCreatedSig = Signal(dict)
+    markerClickedSig = Signal(str, int)
+    viewChangedSig = Signal(float, float, int)
+
+    @Slot()
+    def ready(self):
+        self.readySig.emit()
+
+    @Slot(str)
+    def drawCreated(self, payload):
+        try:
+            self.drawCreatedSig.emit(json.loads(payload))
+        except Exception:
+            pass
+
+    @Slot(str, int)
+    def markerClicked(self, layer, marker_id):
+        self.markerClickedSig.emit(layer, marker_id)
+
+    @Slot(float, float, int)
+    def viewChanged(self, lat, lng, zoom):
+        self.viewChangedSig.emit(lat, lng, zoom)
+
+
+# ----------------------------------------------------------------------------
+# Marker styling (ported from the folium implementation)
+# ----------------------------------------------------------------------------
+def event_marker_radius(mag: float) -> float:
+    if mag is None or (isinstance(mag, float) and np.isnan(mag)):
+        return 5
+    if mag < 2:
+        r = 0.5
+    elif mag < 3:
+        r = 1.0
+    elif mag < 4:
+        r = 1.5
+    elif mag <= 5:
+        r = 2.0
+    elif mag >= 8:
+        r = 18.0
+    else:
+        x = (mag - 5) / 3
+        r = 2 + 16 * x ** 2
+    return float(np.clip(r, 5, 15))
+
+
+def depth_colors(depths) -> List[str]:
+    norm = mcolors.Normalize(vmin=DEPTH_VMIN, vmax=DEPTH_VMAX)
+    rgba = mpl.colormaps["inferno_r"](norm(np.asarray(depths, dtype=float)))
+    return [mcolors.rgb2hex(c[:3]) for c in rgba]
+
+
+def category_colors(values) -> Dict[str, str]:
+    cats = list(pd.unique(pd.Series(values).astype(str)))
+    n = min(len(cats), MAX_LEGEND_CATEGORIES + 1) or 1
+    cmap = mpl.colormaps["tab10"].resampled(n)
+    return {c: mcolors.rgb2hex(cmap(i % n)[:3]) for i, c in enumerate(cats)}
+
+
+def depth_legend_html() -> str:
+    """Vertical colour bar: rotated title on the left, ticks on the right (shallow at top)."""
+    stops = ", ".join(mcolors.rgb2hex(mpl.colormaps["inferno_r"](x)[:3]) for x in np.linspace(0, 1, 12))
+    ticks = "".join(
+        f'<div style="top:{100 * (v - DEPTH_VMIN) / (DEPTH_VMAX - DEPTH_VMIN):.1f}%">{v:g}</div>'
+        for v in (0, 100, 200, 300, 400, 500))
+    return ('<div class="cbar"><div class="title">Depth (km)</div>'
+            f'<div class="bar" style="background:linear-gradient(to bottom, {stops})"></div>'
+            f'<div class="ticks">{ticks}</div></div>')
+
+
+def category_legend_html(title: str, cmap: Dict[str, str]) -> str:
+    items = list(cmap.items())
+    rows = [f'<div><span class="sw" style="background:{c}"></span>{html.escape(k)}</div>'
+            for k, c in items[:MAX_LEGEND_CATEGORIES]]
+    if len(items) > MAX_LEGEND_CATEGORIES:
+        rows.append(f"<div>… +{len(items) - MAX_LEGEND_CATEGORIES} more</div>")
+    return f"<b>{html.escape(title)}</b>" + "".join(rows)
+
+
+def _popup_table(row: pd.Series, title: str, skip=("is_selected",)) -> str:
+    cells = "".join(
+        f"<tr><td><b>{html.escape(str(k))}</b></td><td>{html.escape(_fmt(v))}</td></tr>"
+        for k, v in row.items() if k not in skip)
+    return f'<div class="sv-popup"><h4>{html.escape(title)}</h4><table>{cells}</table></div>'
+
+
+def _fmt(v) -> str:
+    if isinstance(v, float):
+        return f"{v:.4f}".rstrip("0").rstrip(".")
+    return str(v)
+
+
+def build_markers(df: pd.DataFrame, step: Steps, selected: Optional[set] = None):
+    """Return (markers, legend_html) for an event or station DataFrame.
+    Marker ids are the DataFrame's positional row numbers."""
+    selected = selected or set()
+    if df is None or df.empty:
+        return [], ""
+    markers = []
+    if step == Steps.EVENT:
+        colors = depth_colors(df["depth (km)"].to_numpy())
+        legend = depth_legend_html()
+        for pos, (label, row) in enumerate(df.iterrows()):
+            place = str(row.get("place", ""))
+            mag = row.get("magnitude")
+            tip = f"M{mag:.1f} {row.get('magnitude type', '')} — {place[:50]}<br>{row.get('time')}"
+            markers.append({
+                "id": pos, "lat": float(row["latitude"]), "lon": lon_to_360(float(row["longitude"])),
+                "color": colors[pos], "r": event_marker_radius(mag), "sel": label in selected,
+                "shape": "circle", "tip": tip, "popup": _popup_table(row, place)})
+    else:
+        cmap = category_colors(df["network"])
+        legend = category_legend_html("Network", cmap)
+        for pos, (label, row) in enumerate(df.iterrows()):
+            code = f"{row['network']}.{row['station']}"
+            tip = f"{code} — {html.escape(str(row.get('description', '')))[:50]}"
+            markers.append({
+                "id": pos, "lat": float(row["latitude"]), "lon": lon_to_360(float(row["longitude"])),
+                "color": cmap[str(row["network"])], "r": 7, "sel": label in selected,
+                "shape": "tri", "tip": tip, "popup": _popup_table(row, code)})
+    return markers, legend
+
+
+def build_prev_markers(df: pd.DataFrame, step: Steps):
+    """Markers for the previous step's selection (always drawn 'selected', no legend)."""
+    if df is None or df.empty:
+        return []
+    m, _ = build_markers(df, step, selected=set(df.index))
+    for x in m:
+        x["fo"] = 0.9
+    return m
+
+
+def areas_to_js(geo_constraints: List[GeometryConstraint]) -> List[dict]:
+    out = []
+    for gc in geo_constraints or []:
+        c = gc.coords
+        if isinstance(c, RectangleArea):
+            out.append({"type": "rect", "min_lat": c.min_lat, "max_lat": c.max_lat,
+                        "min_lon": c.min_lon, "max_lon": c.max_lon, "color": c.color or AREA_COLOR})
+        elif isinstance(c, CircleArea):
+            out.append({"type": "circle", "lat": c.lat, "lon": c.lon,
+                        "min_r_m": degrees2kilometers(c.min_radius or 0) * 1000,
+                        "max_r_m": degrees2kilometers(c.max_radius) * 1000,
+                        "color": c.color or AREA_COLOR})
+    return out
+
+
+def drawing_to_constraints(g: dict) -> List[GeometryConstraint]:
+    """Convert a Leaflet.draw payload to normalised GeometryConstraints."""
+    if g.get("type") == "rectangle":
+        gc = GeometryConstraint(coords=RectangleArea(
+            min_lat=max(-90.0, g["south"]), max_lat=min(90.0, g["north"]),
+            min_lon=g["west"], max_lon=g["east"]))
+        return normalize_bounds(gc)
+    if g.get("type") == "circle":
+        gc = GeometryConstraint(coords=CircleArea(
+            lat=g["lat"], lon=g["lng"], min_radius=0,
+            max_radius=kilometer2degrees(g["radius_m"] / 1000.0)))
+        return normalize_circle(gc)
+    return []
+
+
+# ----------------------------------------------------------------------------
+# Widget
+# ----------------------------------------------------------------------------
+class MapWidget(QWidget):
+    drawCreated = Signal(list)           # list[GeometryConstraint]
+    markerClicked = Signal(str, int)     # layer ('main'|'prev'), positional id
+    viewChanged = Signal(float, float, int)
+
+    def __init__(self, parent=None):
+        super().__init__(parent)
+        self.view = QWebEngineView(self)
+        page = QWebEnginePage(_shared_profile(), self.view)
+        self.view.setPage(page)
+
+        self._bridge = _Bridge()
+        self._channel = QWebChannel(page)
+        self._channel.registerObject("bridge", self._bridge)
+        page.setWebChannel(self._channel)
+
+        self._ready = False
+        self._queue: List[str] = []
+        self.center = (-20.0, 180.0)
+        self.zoom = 2
+
+        self._bridge.readySig.connect(self._on_ready)
+        self._bridge.drawCreatedSig.connect(lambda g: self.drawCreated.emit(drawing_to_constraints(g)))
+        self._bridge.markerClickedSig.connect(self.markerClicked)
+        self._bridge.viewChangedSig.connect(self._on_view_changed)
+
+        lay = QVBoxLayout(self)
+        lay.setContentsMargins(0, 0, 0, 0)
+        lay.addWidget(self.view)
+
+        self.view.setHtml(page_html(), QUrl(PAGE_ORIGIN))
+
+    # -- plumbing ---------------------------------------------------------
+    def _on_ready(self):
+        self._ready = True
+        for js in self._queue:
+            self.view.page().runJavaScript(js)
+        self._queue.clear()
+
+    def _on_view_changed(self, lat, lng, zoom):
+        self.center, self.zoom = (lat, lng), zoom
+        self.viewChanged.emit(lat, lng, zoom)
+
+    def _call(self, fn: str, *args):
+        js = f"SV.{fn}({', '.join(json.dumps(a, default=str) for a in args)});"
+        if self._ready:
+            self.view.page().runJavaScript(js)
+        else:
+            self._queue.append(js)
+
+    def is_ready(self) -> bool:
+        return self._ready
+
+    # -- public API -------------------------------------------------------
+    def set_markers(self, markers: List[dict], legend_html: str = ""):
+        self._call("setMarkers", markers)
+        self._call("setLegend", legend_html)
+
+    def set_prev_markers(self, markers: List[dict]):
+        self._call("setPrevMarkers", markers)
+
+    def set_selected(self, ids: List[int]):
+        self._call("setSelected", [int(i) for i in ids])
+
+    def set_areas(self, geo_constraints: List[GeometryConstraint]):
+        self._call("setAreas", areas_to_js(geo_constraints))
+
+    def set_view(self, lat: float, lng: float, zoom: int):
+        self.center, self.zoom = (lat, lng), zoom
+        self._call("setView", lat, lng, zoom)
+
+    def fit_markers(self):
+        self._call("fitMarkers")
+
+    def open_popup(self, marker_id: int):
+        self._call("openPopup", int(marker_id))
