+"""Regression checks for reported GUI issues (run via tests/test_qt_gui.py)."""
+import os, sys
+os.environ["QT_QPA_PLATFORM"]="offscreen"; os.environ.setdefault("QTWEBENGINE_CHROMIUM_FLAGS","--no-sandbox --disable-gpu")
